def jenkinsUtil = library identifier: 'innersource-jenkins-utils@main', retriever: modernSCM(
  [
    $class: 'GitSCMSource',
    remote: 'https://github.com/Chewy-Inc/innersource-jenkins-utils.git',
    credentialsId: 'jenkins-github-userpass'
  ]
)

Map environmentToAccount = [
  'DEV': 'XXXXXXXXXXX',
  'QAT': 'XXXXXXXXXXX',
  'STG': 'XXXXXXXXXXX'
]
pipeline {
  agent {
    docker {
      label 'camacho'
      alwaysPull true
      image jenkinsUtil.com.chewy.jenkins.JenkinsDockerAgents.JDK_17_NODE_18_LATEST
      registryUrl "${env.ECR_PRIVATE_REGISTRY}"
      registryCredentialsId "ecr:${AWS_DEFAULT_REGION}:CHEWY-cross-jenkins"
      args '-v /var/lib/jenkins/.gradle/:/home/jenkins/.gradle/ -v /var/lib/jenkins/.ssh/:/home/jenkins/.ssh/ -v /var/run/docker.sock:/var/run/docker.sock -v /usr/bin/docker:/usr/bin/docker --group-add 992 -u root:root'
    }
  }
  options {
    ansiColor('xterm')
    disableConcurrentBuilds()
  }
  environment {
    ARTIFACTORY_USER = credentials('artifactory-username')
    ARTIFACTORY_PASSWORD = credentials('artifactory-password')
    ARTIFACTORY_URL = 'https://chewyinc.jfrog.io/chewyinc'
  }
  parameters {
    choice(
      name: 'DEPLOY_TO',
      choices: ['STG', 'QAT', 'DEV'], //Default will be STG
      description: 'Deploy to a specific environment'
    )
    string(
      name: 'TEST_TAGS',
      defaultValue: '@all',
      description: 'Enter tags to run\n Options:\n 1) @all\n 2) @3pt\n 3) @wallet\n 4) @autoship\n 5) @checkout\n 6) @practicehub\n 7) @loyalty\n 8) @guestuser\n  9) @paymentrevision\n 10) @applepay\n 11) @creditcard\n 12) @paypal\n 13) @googlepay\n 14) @csr\n 15) @mobileviewport\n 16) @cardEasy\n 17) @bpm\n Example: To run all 3pt and wallet do @3pt|@wallet \n To run creditcard case of autoship do @autoship.*@creditcard.\n To run both examples, do @3pt|@wallet|@autoship.*@creditcard'
    )
  }
  stages {
    stage('Build') {
      steps {
        configFileProvider([configFile(fileId: 'npmrc-default', targetLocation: './.npmrc')]) {
          withCredentials([
            usernamePassword(
              credentialsId: 'jenkins-github-userpass',
              passwordVariable: 'GRGIT_PASS', usernameVariable: 'GRGIT_USER'
            )
          ]) {
            script {
              withAWS(role: 'arn:aws:iam::278833423079:role/CHEWY-cross-jenkins') {
                sh 'yarn install --frozen-lockfile'
              }
            }
          }
        }
      }
    }
    stage('Playwright UI tests') {
      steps {
        script {
          withCredentials([usernamePassword(credentialsId: 'jenkins-github-userpass', passwordVariable: 'GRGIT_PASS', usernameVariable: 'GRGIT_USER')]) {
            docker.withRegistry("${env.ECR_PRIVATE_REGISTRY}", "ecr:${AWS_DEFAULT_REGION}:CHEWY-cross-jenkins") {
              docker.image('278833423079.dkr.ecr.us-east-1.amazonaws.com/plat/mcr.microsoft.com-playwright:v1.45.0-jammy').inside("-u root -e GITHUB_TOKEN=${GRGIT_PASS} -e HOME=${env.WORKSPACE} -e ARTIFACTORY_URL=${ARTIFACTORY_URL} -e ARTIFACTORY_USER=${ARTIFACTORY_USER} -e ARTIFACTORY_PASSWORD=${ARTIFACTORY_PASSWORD}") {
                withAWS(role: "arn:aws:iam::${environmentToAccount[params.DEPLOY_TO]}:role/CHEWY-cross-jenkins") {
                  catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    def deployEnv = params.DEPLOY_TO
                    def testTags = params.TEST_TAGS
                    sh 'npm config fix'
                    sh "STAGE=${deployEnv} npm run playwright:run -- --grep '${testTags}'"
                  }
                }
                stash includes: 'allure-results/**/*', name: 'shard1'
                sh 'rm -rf allure-results'
                sh 'rm -rf test-results'
              }
            }
          }
        }
      }
    }
    stage('Make report') {
      steps {
        unstash 'shard1'
        sh 'mkdir -p /var/lib/jenkins/jenkins-agent/tools/ru.yandex.qatools.allure.jenkins.tools.AllureCommandlineInstallation/allure-2.13.5'
        sh 'wget --user="${ARTIFACTORY_USER}" --password="${ARTIFACTORY_PASSWORD}" https://chewyinc.jfrog.io/chewyinc/thirdparty-binaries/io/qameta/allure/allure-commandline/2.13.5/allure-commandline-2.13.5.tgz -O /var/lib/jenkins/jenkins-agent/tools/ru.yandex.qatools.allure.jenkins.tools.AllureCommandlineInstallation/allure-2.13.5/allure-commandline-2.13.5.tgz'
        sh 'tar -xzf /var/lib/jenkins/jenkins-agent/tools/ru.yandex.qatools.allure.jenkins.tools.AllureCommandlineInstallation/allure-2.13.5/allure-commandline-2.13.5.tgz -C /var/lib/jenkins/jenkins-agent/tools/ru.yandex.qatools.allure.jenkins.tools.AllureCommandlineInstallation/allure-2.13.5/'
        sh 'chmod +x /var/lib/jenkins/jenkins-agent/tools/ru.yandex.qatools.allure.jenkins.tools.AllureCommandlineInstallation/allure-2.13.5/allure-2.13.5/bin/allure'
        sh '/var/lib/jenkins/jenkins-agent/tools/ru.yandex.qatools.allure.jenkins.tools.AllureCommandlineInstallation/allure-2.13.5/allure-2.13.5/bin/allure --version'
        sh 'npm run allure:create'
        allure results: [[path: '**/allure_report']]
      }
    }
  }
